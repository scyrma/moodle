{{!
    @template tool_program/archived_programs_list

    Template for showing list of programs

    Example context (json):
    {
        "programslisttable": {"html": "<div>Content goes here...<div>"},
        "tabheading": "Archived programs"
    }
}}
<div class="tool_program_archive_programs_list" data-region="archive-programs">
    {{> tool_wp/tab_heading }}
    {{{programsarchivedlisttable}}}
</div>
{{#js}}
    require(['tool_program/program_manager'], function(ProgramManager) {
        new ProgramManager('[data-region="archive-programs"]');
    });
{{/js}}