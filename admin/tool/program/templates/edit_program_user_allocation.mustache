{{!
    @template tool_program/edit_program_user_allocation

    Template for user allocation into program.

    Example context (json):
    {
        "tabheading": "Users list",
        "addbuttontitle": "Allocate user",
        "programid": "1",
        "userstable": "<div>Table goes here...</div>"
    }
}}
{{> tool_wp/tab_heading }}
<div data-region="edit-program-user-allocation">
    <div data-region="edit-program-user-list">
        {{{userstable}}}
    </div>
</div>
{{#js}}
    M.util.js_pending('tool_program_user_alloc');
    require(['tool_program/user_allocations'], function(s) {
        s.init();
        M.util.js_complete('tool_program_user_alloc');
    });
{{/js}}
