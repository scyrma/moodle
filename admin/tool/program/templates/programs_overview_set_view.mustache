{{!
    @template tool_program/programs_overview_set_view

    Template for showing overview.

    Example context (json):
    {
        "unlocked": "1",
        "name": "Name",
        "statusmessage": "completed",
        "statusmessagestr": "Completed",
        "showprogress": "1",
        "completeditems": "5",
        "completionatleast": "1",
        "totalitems": "6",
        "progress": "100",
        "itemstobecompleted": "4"
    }
}}

<div class="programitem px-5 border-bottom border-gray030" data-region="programs-overview-set-view">
    <div class="d-flex">
        <div class="indent indent-{{level}}"></div>
        <a href="#"
                class="flex-fill p-2 d-flex ws-toggle text-decoration-none text-gray080 collapsed"
                data-component="tool_program"
                data-toggle="collapse"
                data-target="#set-{{id}}"
                aria-expanded="false"
                aria-controls="set-{{id}}"
                role="button"
            >
            <span class="togglesectionicon collapsed-icon-container">
                {{#pix}} t/collapsedcaret, core, {{#str}} expand, moodle {{/str}}{{/pix}}
            </span>
            <span class="togglesectionicon expanded-icon-container">
                {{#pix}} t/expanded, core, {{#str}} collapse, moodle {{/str}}{{/pix}}
            </span>
            <div class="media">
                <span class="mr-2 {{#iscompleted}}completed{{/iscompleted}}">
                    {{^unlocked}}
                        {{#pix}}t/locked, core, {{#str}} locked, tool_program {{/str}} {{/pix}}
                    {{/unlocked}}
                    {{#unlocked}}
                        {{#iscompleted}}
                            {{#pix}}folder-open-o, tool_wp, {{#str}} completed, tool_program {{/str}} {{/pix}}
                        {{/iscompleted}}
                        {{^iscompleted}}
                            {{#pix}}a/view_tree_active, core, {{#str}} set, tool_program {{/str}} {{/pix}}
                        {{/iscompleted}}
                    {{/unlocked}}
                </span>
                <div class="media-body">
                    {{{name}}}
                    <div class="text-gray080 small">
                        {{statusmessagestr}} {{#showprogress}}({{completeditems}}/{{totalitems}}){{/showprogress}}
                    </div>
                </div>
            </div>
        </a>
        <div class="p-2 my-auto">
            {{> tool_program/programs_overview_view_progress_bar }}
        </div>
    </div>
</div>
<div
    id="set-{{id}}"
    class="content collapse"
    aria-labelledby="set-{{id}}"
    data-section="tool_program"
    aria-expanded="false"
    role="contentinfo">
    {{> tool_program/programs_overview_recursive_view }}
</div>
