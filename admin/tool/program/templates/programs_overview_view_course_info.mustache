{{!
    @template tool_program/programs_overview_view_course_info

    Template for showing program course details.

    Example context (json):
    {
        "courseid": "1",
        "courseinfoimage": "http://image",
        "progress": "50",
        "courseinfo": "Name of the course<br>Summary of the course",
        "name": "Name of the course"
    }
}}
<div class="modal fade courseinfomodal" id="courseinfomodal{{courseid}}" tabindex="-1" role="dialog" aria-labelledby="courseinfomodalheader{{courseid}}" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <img alt="" src="{{courseinfoimage}}" class="img-fluid w-100">
            </div>
            <div class="modal-body">
                <div class="px-5 py-4 bg-gray010 coursename-container">
                    <span class="element-type">{{#str}}course{{/str}} · {{{category}}}</span>
                    <h4 id="courseinfomodalheader{{courseid}}" class="mb-0 modal-title">{{{name}}}</h4>
                </div>
                <div class="px-5">
                    {{#completionenabled}}
                        <div class="progress-container mt-4">
                            <div class="progress bg-white border">
                                <div class="progress-bar bar" role="progressbar" aria-valuenow="{{progress}}" style="width: {{progress}}%" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="small">
                                <strong>{{progress}}</strong>% {{#str}} completed, tool_program {{/str}}
                            </div>
                        </div>
                    {{/completionenabled}}
                    {{{courseinfo}}}
                </div>
            </div>
            <div class="modal-footer">
                {{#isenrolled}}
                    <a class="btn btn-primary" href="{{url}}" role="button">{{#str}} gotocourse, tool_program {{/str}}</a>
                {{/isenrolled}}
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">{{#str}} close, tool_program {{/str}}</button>
            </div>
        </div>
    </div>
</div>