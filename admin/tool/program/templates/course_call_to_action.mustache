{{!
    @template tool_program/course_call_to_action

    Template for showing course call to action button / information.

    Example context (json):
    {
        "unlocked": "1",
        "iscompleted": "1",
        "isenrolled": "1",
        "isstarted": "1",
        "courseid": "35",
        "programid": "29"
    }
}}
<div data-region="course-call-to-action">
    {{^unlocked}}
        <button class="btn btn-gray030 text-uppercase btn-sm"
                data-toggle="popover"
                data-content='{{{unlockrequirement}}}'
                data-html="true"
                data-trigger="hover">
            {{#str}} requires, tool_program {{/str}}
        </button>
    {{/unlocked}}
    {{#unlocked}}
        {{#iscompleted}}
            <a href="{{url}}"
               class="btn btn-gray030 text-uppercase btn-sm {{#viewasmode}}disabled{{/viewasmode}}"
               role="button"
               {{#viewasmode}}aria-disabled="true"{{/viewasmode}}>
                {{#str}} review, tool_program {{/str}}
            </a>
        {{/iscompleted}}
        {{^iscompleted}}
            {{^isenrolled}}
                <button class="btn btn-gray030 text-uppercase btn-sm enrol_to_course"
                        data-courseid="{{courseid}}"
                        data-programid="{{programid}}"
                        {{#viewasmode}}disabled{{/viewasmode}}>
                    {{#str}} enrol, tool_program {{/str}}
                </button>
            {{/isenrolled}}
            {{#isenrolled}}
                {{^completedactivities}}
                    <a href="{{url}}"
                       class="btn btn-gray030 text-uppercase btn-sm {{#viewasmode}}disabled{{/viewasmode}}"
                       role="button"
                       {{#viewasmode}}aria-disabled="true"{{/viewasmode}}>
                        {{#str}} start, tool_program {{/str}}
                    </a>
                {{/completedactivities}}
                {{#completedactivities}}
                    <a href="{{url}}"
                       class="btn btn-gray030 text-uppercase btn-sm {{#viewasmode}}disabled{{/viewasmode}}"
                       role="button"
                       {{#viewasmode}}aria-disabled="true"{{/viewasmode}}>
                        {{#str}} continue, tool_program {{/str}}
                    </a>
                {{/completedactivities}}
            {{/isenrolled}}
        {{/iscompleted}}
    {{/unlocked}}
</div>
