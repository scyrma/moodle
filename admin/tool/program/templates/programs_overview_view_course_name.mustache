{{!
    @template tool_program/programs_overview_view_course_name

    Template for showing course link.

    Example context (json):
    {
        "unlocked": "1",
        "iscompleted": "1",
        "isenrolled": "1",
        "isstarted": "1",
        "courseid": "35",
        "programid": "29"
    }
}}
<div data-region="course-call-to-action">
    {{#viewasmode}}
        {{{name}}}
    {{/viewasmode}}
    {{^viewasmode}}
        {{^unlocked}}
            <a class="btn btn-link p-0"
               role="button"
               data-toggle="popover"
               data-content="{{unlockrequirement}}"
               data-trigger="focus"
               tabindex="0">
                {{{name}}}
            </a>
        {{/unlocked}}
        {{#unlocked}}
            {{#iscompleted}}
                <a href="{{url}}"
                   title="{{#str}} review, tool_program {{/str}}">
                    {{{name}}}
                </a>
            {{/iscompleted}}
            {{^iscompleted}}
                {{^isenrolled}}
                    <button class="btn btn-link p-0 enrol_to_course"
                            data-courseid="{{courseid}}"
                            data-programid="{{programid}}"
                            title="{{#str}} enrol, tool_program {{/str}}">
                        {{{name}}}
                    </button>
                {{/isenrolled}}
                {{#isenrolled}}
                    {{^completedactivities}}
                        <a href="{{url}}"
                           title="{{#str}} start, tool_program {{/str}}">
                            {{{name}}}
                        </a>
                    {{/completedactivities}}
                    {{#completedactivities}}
                        <a href="{{url}}"
                           title="{{#str}} continue, tool_program {{/str}}">
                            {{{name}}}
                        </a>
                    {{/completedactivities}}
                {{/isenrolled}}
            {{/iscompleted}}
        {{/unlocked}}
    {{/viewasmode}}

</div>
