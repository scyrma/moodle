{{!
    @template tool_program/edit_program_content

    Template for showing program content.

    Example context (json):
    {
        "tabheading": "Content",
        "baseset": {
            "id": "1",
            "setcompletionform": "<form></form>"
        },
        "programid": "1",
        "editmode": "1"
    }
}}
<div class="program-items program-item-children" data-region="edit-content">

    {{#mainset}}

    {{#editmode}}
    <div class="pull-right">
        <div class="dropdown d-inline-block">
            <button class="btn btn-primary iconlarge nomargin dropdown-toggle" type="button"
                    id="addItemToSet{{id}}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                {{#pix}}t/add, core{{/pix}}
                <span class="sr-only">{{#str}}addsetorcourse, tool_program{{/str}}</span>
            </button>
            <div class="dropdown-menu" aria-labelledby="addItemToSet{{id}}">
                <a class="dropdown-item add-set" data-action="add-set" data-set-id="{{id}}" href="#">{{#str}} set, tool_program {{/str}}</a>
                <a class="dropdown-item add-course" data-action="add-course" data-set-id="{{id}}" href="#">{{#str}} course, tool_program {{/str}}</a>
            </div>
        </div>
    </div>
    {{/editmode}}

    {{> tool_wp/tab_heading}}

    {{> tool_wp/table_tree}}

    <div>
        <table class="my-4 pull-right">
            <tr>
                <td>
                    <span class="mr-2">{{#str}} maincompletion, tool_program {{/str}}:</span>
                </td>
                <td>
                    {{{setcompletionform}}}
                </td>
            </tr>
        </table>
    </div>
    <div class="clearfix"></div>

    {{/mainset}}

</div>

{{#editmode}}{{#js}}
    M.util.js_pending('tool_program_content');
    require(['tool_program/edit_content'], function(EditSetsAndCourses) {
        new EditSetsAndCourses();
        M.util.js_complete('tool_program_content');
    });
{{/js}}{{/editmode}}
