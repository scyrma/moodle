{{!
    @template tool_program/programs_overview_view_progress_bar

    This template renders a doughnut chart to show course progress.

    Example context (json):
    {
        "iscompleted": true,
        "progress": "60"
    }
}}
<div class="progress progress-thin programprogress d-none d-sm-block">
    <div class="progress-bar {{#iscompleted}}bg-success{{/iscompleted}} {{^iscompleted}}bg-info-light{{/iscompleted}}"
         role="progressbar"
         style="width: {{progress}}%;"
         aria-valuenow="{{progress}}"
         aria-valuemin="0"
         aria-valuemax="100">
        <span class="sr-only">{{percentagecompleted}}% {{#str}} completed, tool_program {{/str}}</span>
    </div>
</div>
