{{!
    @template tool_program/edit_program_content_add_set

    Template for + icon to add set/course

    Example context (json):
    {
        "id": 1,
        "parent": 0
    }
}}

<div class="dropdown d-inline-block">
    <a href="#" class="dropdown-toggle" id="addItemToSet{{id}}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="{{#str}}addsetorcourse, tool_program{{/str}}">
        {{#pix}}plus-circle, tool_wp{{/pix}}
        <span class="sr-only">{{#str}}addsetorcourse, tool_program{{/str}}</span>
    </a>
    <div class="dropdown-menu" aria-labelledby="addItemToSet{{id}}">
        <a class="dropdown-item add-set" data-action="add-set" data-set-id="{{id}}" href="#">{{#str}} set, tool_program {{/str}}</a>
        <a class="dropdown-item add-course" data-action="add-course" data-set-id="{{id}}" href="#">{{#str}} course, tool_program {{/str}}</a>
    </div>
</div>