{{!
    @template tool_program/program_progress_overview

    Template for showing progress percentage and links to progress reports

    Example context (json):
    {
        "allocationid": "1",
        "contextid": "1",
        "title": "hello world",
        "progresspercent": "100%",
        "viewasmode": "1",
        "userprogramurl": "url"
    }
}}
<div data-region="program-progress-overview">
    {{progresspercent}}
    {{#viewasmode}}
        <a href="javascript:" class="m-0 ml-1 p-0 program-progress-overview-trigger" data-allocationid="{{allocationid}}" data-title="{{title}}" data-contextid="{{contextid}}">{{#pix}} i/dashboard, core, {{#str}} progressoverview, tool_program {{/str}}{{/pix}}</a>
        <a href="{{userprogramurl}}" class="m-0 p-0">{{#pix}} bar-chart, tool_wp, {{#str}} progressreport , tool_program {{/str}}{{/pix}}</a>
    {{/viewasmode}}
</div>
{{#viewasmode}}{{#js}}
    require(['tool_program/program_progress_modal'], function(ProgramProgressModal) {
        ProgramProgressModal.init();
    });
{{/js}}{{/viewasmode}}
