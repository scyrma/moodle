{{!
    @template tool_program/programs_overview_course_view

    Template for showing overview.

    Example context (json):
    {
        "unlocked": "1",
        "iscompleted": "1",
        "isenrolled": "1",
        "name": "Name",
        "statusmessage": "completed",
        "statusmessagestr": "Completed",
        "showprogress": "0",
        "courseid": "3",
        "programid": "4",
        "progress": "100",
        "courseinfo": "Name of the course<br>Summary of the course",
        "courseinfoimage": "http://image"
    }
}}
<div class="programitem programrow px-5 border-bottom border-gray030" data-region="programs-overview-course-view">
    <div class="d-flex">
        <div class="indent indent-{{level}}"></div>
        <div class="flex-fill d-flex p-2 my-auto">
            <div class="media">
                <span class="mr-2 {{#iscompleted}}{{#unlocked}}completed{{/unlocked}}{{^unlocked}}text-warning{{/unlocked}}{{/iscompleted}}">
                    {{#ishidden}}
                        {{#pix}}exclamation-triangle, tool_wp, {{#str}} notavailable , tool_program {{/str}}{{/pix}}
                    {{/ishidden}}
                    {{^ishidden}}
                        {{#unlocked}}
                            {{#iscompleted}}
                                {{#pix}}e/tick, core, {{statusmessagestr}} {{/pix}}
                            {{/iscompleted}}
                            {{^iscompleted}}
                                {{#isenrolled}}
                                    {{#pix}}t/right, core, {{statusmessagestr}} {{/pix}}
                                {{/isenrolled}}
                                {{^isenrolled}}
                                    {{#pix}}i/course, core, {{statusmessagestr}} {{/pix}}
                                {{/isenrolled}}
                            {{/iscompleted}}
                        {{/unlocked}}
                        {{^unlocked}}
                            {{#iscompleted}}
                                {{#pix}}a/wp-hourglass, theme, {{statusmessagestr}} {{/pix}}
                            {{/iscompleted}}
                            {{^iscompleted}}
                                {{#pix}}t/locked, core, {{statusmessagestr}} {{/pix}}
                            {{/iscompleted}}
                        {{/unlocked}}
                    {{/ishidden}}
                </span>
                <div class="media-body">
                    {{> tool_program/programs_overview_view_course_name }}
                    <div class="text-gray080 small">
                        {{statusmessagestr}}
                    </div>
                </div>
            </div>
        </div>
        {{^ishidden}}
            {{#showfilters}}
                <button type="button" class="btn" data-toggle="modal" data-target="#courseinfomodal{{courseid}}" title="{{#str}} courseinformation, tool_program {{/str}}">
                    {{#pix}}info-circle, tool_wp {{/pix}}
                </button>
            {{/showfilters}}
        {{/ishidden}}
        <div class="p-2 my-auto">
            {{^ishidden}}
                {{> tool_program/programs_overview_view_progress_bar }}
            {{/ishidden}}
        </div>
    </div>
</div>
