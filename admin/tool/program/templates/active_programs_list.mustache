{{!
    @template tool_program/active_programs_list

    Template for showing list of prograns

    Example context (json):
    {
        "addbuttontitle": "Add new program",
        "programslisttable": "<table></table>",
        "tabheading": "Active programs",
        "newprogramurl": "#"
    }
}}
<div class="tool_program_active_programs_list" data-region="active-programs">
    {{> tool_wp/tab_heading }}
    {{{programslisttable}}}
</div>
{{#js}}
    require(['tool_program/program_manager'], function(ProgramManager) {
        new ProgramManager('[data-region="active-programs"]');
    });
{{/js}}
