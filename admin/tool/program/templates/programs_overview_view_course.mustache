{{!
    @template tool_program/programs_overview_view_course

    Template for showing course elements in dashboard.

    Example context (json):
    {
        "id": "1",
        "image": "http://image",
        "iscompleted": false,
        "progress": "50",
        "fullname": "Name of the course",
        "category": "Name of the category"
    }
}}
<div class="dashboard-item" data-lowestduedate="{{lowestduedate}}" data-completed="{{iscompleted}}" data-lastaccess="{{lastaccess}}"
     {{^isprogram}}data-courses="1"{{/isprogram}}>
    <!-- Expanded view -->
    <div class="view viewcards mb-3 bg-white wp-boxshadow-1 border-radius">
        <div class="programinfo p-4 border-bottom">
            <div class="d-flex mb-3">
                <div data-component="tool_program">
                    <div class="media">
                        {{#image}}
                            <div class="courseimage rounded mr-3 ml-auto d-none d-sm-block"
                                 style='background-image: url("{{{image}}}");'>
                                <span class="sr-only">{{#str}}programimage_help, tool_program{{/str}}</span>
                            </div>
                        {{/image}}
                        <div class="media-body py-1">
                            <div class="element-type">{{#str}}course{{/str}} · {{{categoryname}}}</div>
                            <div class="element-name" data-region="programname">{{{fullname}}}</div>
                        </div>
                    </div>
                </div>
                <div class="progress-circle ml-auto d-flex">
                    {{^viewasmode}}
                    <button type="button" class="btn btn-info-small" data-toggle="modal" data-target="#courseinfomodal{{id}}" title="{{#str}} courseinformation, tool_program {{/str}}">
                        {{#pix}}info-circle, tool_wp {{/pix}}
                        <span class="sr-only">{{#str}} courseinformation, tool_program {{/str}}</span>
                    </button>
                    {{/viewasmode}}
                    {{#completionenabled}}
                        {{> tool_program/programs_overview_view_progress_pie }}
                    {{/completionenabled}}
                </div>
            </div>

            <div class="content pt-2 border-top" data-section="tool_program" role="contentinfo">
                <div class="d-flex pt-3 align-items-center align-items-stretch justify-content-end">
                    <div class="bg-gray020 flex-fill px-4 py-2 ml-0 font-size-menus d-flex align-items-center">
                                <span class="mr-2">
                                    {{#pix}} play-circle, tool_wp {{/pix}}
                                </span>
                        {{{startdatestr}}}
                    </div>
                    <div class="bg-gray020 flex-fill px-4 py-2 ml-0 ml-sm-3 font-size-menus d-flex align-items-center">
                                <span class="mr-2">
                                    {{#pix}} hourglass-end, tool_wp {{/pix}}
                                </span>
                        {{{enddatestr}}}
                    </div>
                    <a class="btn btn-primary btn-lg ml-sm-3 {{#viewasmode}}disabled{{/viewasmode}}"
                       title="{{#str}}gotocourse, tool_program{{/str}}"
                       role="button"
                       {{#viewasmode}}aria-disabled="true"{{/viewasmode}}
                       href="{{config.wwwroot}}/course/view.php?id={{id}}">
                       {{#str}}gotocourse, tool_program{{/str}}
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{^viewasmode}}
        <!-- Collapsed view -->
        <div class="view viewlist bg-white border">
            <div class="d-flex align-items-center py-2 px-3">
                {{#image}}
                    <div class="courseimage rounded mr-3 ml-auto d-none d-sm-block" style='background-image: url("{{{image}}}");'>
                        <span class="sr-only">{{#str}}programimage_help, tool_program{{/str}}</span>
                    </div>
                {{/image}}
                <div class="media-body">
                    <div class="element-type">{{#str}}course{{/str}} · {{{categoryname}}}</div>
                    <a href="{{config.wwwroot}}/course/view.php?id={{id}}" class="element-name mt-1 text-gray080 text-decoration-none">{{{fullname}}}</a>
                </div>
                <div class="d-flex">
                    <button type="button" class="btn btn-info-small p-0 ml-3 my-auto" data-toggle="modal" data-target="#courseinfomodal{{id}}" title="{{#str}} courseinformation, tool_program {{/str}}">
                        {{#pix}}info-circle, tool_wp {{/pix}}
                        <span class="sr-only">{{#str}} courseinformation, tool_program {{/str}}</span>
                    </button>
                    {{#completionenabled}}
                        <div class="my-auto ml-2">
                            {{> tool_program/programs_overview_view_progress_pie }}
                        </div>
                    {{/completionenabled}}
                    <div class="calltoaction ml-3">
                        <a class="btn btn-outline-secondary w-100 {{#viewasmode}}disabled{{/viewasmode}}"
                           title="{{#str}}gotocourse, tool_program{{/str}}"
                           role="button"
                           {{#viewasmode}}aria-disabled="true"{{/viewasmode}}
                           href="{{config.wwwroot}}/course/view.php?id={{id}}">
                        {{#str}}gotocourse, tool_program{{/str}}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {{/viewasmode}}
</div>