{{!
    @template tool_organisation/rolespermissions

    List of hardcoded permissions assigned to role

    Context variables required for this template:

    Example context (json):
    {
        "roletitle":"Department manager",
        "permissions": [
            {
                "title": "With permission \"Allocate users to programs\/certifications\"",
                "icon": "fa fa-graduation-cap",
                "set": true
            },
            {
                "title": "Without permission \"Receive notifications\"",
                "icon": "fa fa-paper-plane",
                "set": false
            }
        ],
        "extraclass": "perm-global-manager",
        "showpermissionsonly": false
    }
}}
{{^showpermissionsonly}}
<div class="node-roles-permissions row {{#extraclass}}{{extraclass}}{{/extraclass}}" >
    <div class="col-6"><span class="badge badge-secondary">{{roletitle}}</span></div>
    <div class="col-6">
    {{#permissions}}
        <span title="{{title}}" class="tool-ogranisation-perm-icon {{^set}}noset{{/set}}" >
            {{{icon}}}
        </span>
    {{/permissions}}
    </div>
</div>
{{/showpermissionsonly}}

{{! If only permission icons to be shown. }}
{{#showpermissionsonly}}
  <div class="node-roles-permissions container {{#extraclass}}{{extraclass}}{{/extraclass}} px-0" >
      {{#permissions}}
          <span title="{{title}}" class="tool-ogranisation-perm-icon {{^set}}noset{{/set}}" >
              {{{icon}}}
          </span>
      {{/permissions}}
  </div>
{{/showpermissionsonly}}
