{{!
    @template tool_organisation/dashboard_team_user

    Tab with jobs (for management)

    Context variables required for this template:

    Example context (json):
    {
        "id": 1,
        "uniqueid": "rAnd0m",
        "userpicture": "<img src='https://raw.githubusercontent.com/moodle/moodle/master/pix/g/f1.png' width='35' height='35' alt='pic'>",
        "userfullname": "John Doe",
        "isglobalmanager": 1,
        "isdepartmentmanager": 1,
        "messageurl": "#",
        "profileurl": "#",
        "attentiontext": "1 expired certification",
        "jobs": [
            { "positionname": "Main developer", "departmentname": "Product", "dates": "From 01/07/2018 to 01/07/2019" },
            { "positionname": "Team lead", "departmentname": "Main office", "dates": "From 01/01/2016" }
        ],
        "userdetails": {"classes": "", "nodes": ["<li>Detail1</li>", "<li>Detail2</li>"]},
        "learning": {"classes": "", "nodes": ["<li>Report1</li>", "<li>Report 2</li>"]}
    }
}}
<div id="dashboard-team-{{uniqueid}}" class="team-user-container bg-white border-bottom">
    <div id="basicdetails-{{id}}" class="d-flex flex-wrap align-items-center">
        <div class="user-container col-6 pl-0 d-flex align-items-center align-self-start justify-content-between">
            <button class="btn btn-link p-3 text-truncate d-flex align-items-center border-0 ws-toggle collapsed" data-toggle="collapse" data-target="#extendeddetails-{{id}}-{{uniqueid}}" aria-expanded="false" aria-controls="extendeddetails-{{id}}-{{uniqueid}}">
                <span class="togglesectionicon collapsed-icon-container">
                    {{#pix}} t/collapsedcaret, core, {{#str}} expand, moodle {{/str}}{{/pix}}
                </span>
                <span class="togglesectionicon expanded-icon-container">
                    {{#pix}} t/expanded, core, {{#str}} collapse, moodle {{/str}}{{/pix}}
                </span>
                <!-- User picture and name -->
                <span class="mr-2">
                    {{#userpicture}}
                        {{{userpicture}}}
                    {{/userpicture}}
                </span>
                <span class="text-truncate">
                    {{{userfullname}}}
                </span>
            </button>
            <!-- Alert -->
            {{#attentiontext}}
                <span class="iconcontainer d-inline-block nomargin mx-3 p-2 text-danger">
                    {{#pix}}exclamation-triangle, tool_wp, {{attentiontext}}{{/pix}}
                </span>
            {{/attentiontext}}
        </div>

        <div class="jobs-container col-6 py-3 pr-3">
            <!-- Jobs -->
                {{#jobs}}
                    <div class="job-container d-flex justify-content-between px-0 py-1">
                        <!-- Job name -->
                        <div class="job-name-container align-self-center">{{#str}} jobname, tool_organisation, { "position": {{#quote}}{{{positionname}}}{{/quote}}, "department": {{#quote}}{{{departmentname}}}{{/quote}} } {{/str}}</div>

                        <!-- Roles -->
                        <div class="job-permissions-container align-self-center">
                            {{#ismanager}}
                                <div class="d-flex justify-content-end">
                                    <span class="badge badge-secondary mb-1">{{#str}} globalmanager, tool_organisation{{/str}}</span>
                                </div>
                            {{/ismanager}}
                            {{#isdepartmentlead}}
                                <div class="d-flex justify-content-end">
                                    <span class="badge badge-secondary">{{#str}} departmentmanager, tool_organisation{{/str}}</span>
                                </div>
                            {{/isdepartmentlead}}
                        </div>
                    </div>
                {{/jobs}}
        </div>
    </div>

    <div id="extendeddetails-{{id}}-{{uniqueid}}" class="collapse">
        <div class="details-wrapper p-4 bg-gray010 border-top">
            <div class="d-flex mb-1 justify-content-end">
                <div class="details-container col-6 px-0">
                    <!-- Learning info -->
                    {{#learning}}
                        {{#nodescount}}
                            <dt>{{#str}} learning, tool_organisation{{/str}}</dt>
                        {{/nodescount}}
                        <div class="profile_tree">
                            <div class="node_category {{classes}} mb-2">
                                <ul class="unlist">
                                    {{#nodes}}{{{.}}}{{/nodes}}
                                </ul>
                            </div>
                        </div>
                    {{/learning}}
                    <!-- User details -->
                    {{#userdetails}}
                        <div class="profile_tree">
                            <div class="node_category {{classes}}">
                                <ul class="unlist">
                                    {{#nodes}}{{{.}}}{{/nodes}}
                                </ul>
                            </div>
                        </div>
                    {{/userdetails}}
                </div>
            </div>
            <!-- Message and profile buttons -->
            <div class="buttons-container d-flex flex-wrap justify-content-end pt-3 border-top">
                {{#canmessage}}
                    <a href="#" class="btn btn-outline-secondary btn-sm" data-userid="{{id}}" data-conversationid="0" data-action="wpmessage" >
                        {{#pix}}t/messages, core, {{#str}}sendmessage, core_message{{/str}}{{/pix}}
                        {{#str}}sendmessage, core_message{{/str}}
                    </a>
                {{/canmessage}}
                {{#profileurl}}
                    <a href="{{profileurl}}" class="profile-button btn btn-outline-secondary btn-sm ml-2" role="button">
                        {{#pix}}i/user, core, {{#str}}viewprofile{{/str}}{{/pix}}
                        {{#str}}viewprofile{{/str}}
                    </a>
                {{/profileurl}}
            </div>
        </div>
    </div>
</div>