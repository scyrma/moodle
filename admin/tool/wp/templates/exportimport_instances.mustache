{{!
    @template tool_wp/exportimport_instances

    Export/Import instances

    Classes required for JS:
    * None

    Data attibutes required for JS:
    * None

    Context variables required for this template:
    * None

    Example context (json):
    {
        "instances":
            {
                "count": 4,
                "morecount": 1,
                "list": [
                    {
                        "name": "Program 01",
                        "value": true
                    },
                    {
                        "name": "Program 02",
                        "value": true
                    },
                    {
                        "name": "Program 03",
                        "value": true
                    },
                    {
                        "name": "Program 04",
                        "value": true
                    }
                ]
            }
    }
}}
<div data-region="exportimport-instances">
    {{#instances}}
    <strong>{{#str}} instancescount, tool_wp, {{instances.count}} {{/str}}</strong>
        <div class="showmorelist">
            <ul class="mb-0" style="list-style: none;">
                {{#instances.list}}
                    <li>
                        {{#value}}{{name}}{{/value}}
                        {{^value}}<del>{{name}}</del>{{/value}}
                    </li>
                {{/instances.list}}
            </ul>
            {{#instances.morecount}}
            <button class="btn btn-link showmore">{{#str}} showxmore, tool_wp, {{ instances.morecount }} {{/str}}</button>
            <button class="btn btn-link showless">{{#str}} showless, tool_wp {{/str}}</button>
            {{/instances.morecount}}
        </div>
    {{/instances}}
</div>

{{#js}}
    require(['tool_wp/import_export'], function(s) {
        s.initShowMoreList();
    });
{{/js}}