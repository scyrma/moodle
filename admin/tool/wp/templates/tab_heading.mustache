{{!
    @template tool_wp/tab_heading

    Template for showing tabs

    Example context (json):
    {
        "tabheading": "Hello",
        "addbuttontitle": "Add",
        "addbuttonurl": ""
    }
}}
<div>
{{#addbuttontitle}}
    <a href="{{#addbuttonurl}}{{addbuttonurl}}{{/addbuttonurl}}{{^addbuttonurl}}#{{/addbuttonurl}}"
       class="btn btn-primary float-right iconlarge nomargin" title="{{addbuttontitle}}"
       data-tabs-element="addbutton" {{#addbuttonattrs}}{{name}}="{{value}}"{{/addbuttonattrs}}>{{#pix}}t/add, core{{/pix}}</a>
{{/addbuttontitle}}
{{#tabheading}}
    <h2>{{{tabheading}}}</h2>
{{/tabheading}}
</div>
<div class="clearfix"></div>
