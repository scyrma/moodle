{{!
    @template tool_wp/table_tree

    Template for showing a tree as a table

    Example context (json):
    {
        "columns": [
            {"class": "col-9", "content": "Name"},
            {"class": "col-3", "content": "Actions"}
        ],
        "canhavechildren": true,
        "children": [
            {
                "columns": [
                    {"class": "col-9", "content": "Node 1"},
                    {"class": "col-3", "content": "[X]"}
                ],
                "canhavechildren": true,
                "children": [
                    {"columns": [
                        {"class": "col-9", "content": "Node 2"},
                        {"class": "col-3", "content": "[Y]"}
                    ],
                    "canhavechildren": false,
                    "children": []}
                ]
            }
        ],
        "tableisempty": false,
        "nothingtodisplay": "Nothing to display"
    }
}}
<div class="tool-wp-table-tree {{treeclass}}" {{#treeattributes}}{{name}}="{{value}}"{{/treeattributes}}>
{{#tableisempty}}
    {{{nothingtodisplay}}}
{{/tableisempty}}
{{^tableisempty}}
    {{> tool_wp/table_tree_node }}
{{/tableisempty}}
</div>
