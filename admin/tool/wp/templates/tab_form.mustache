{{!
    @template tool_wp/tab_form

    Template for showing a tab that contains a form

    Example context (json):
    {
        "formclass": "some\\class",
        "form": "Form contents"
    }
}}
<div data-formclass="{{formclass}}" data-region="tabformwrapper">
    {{{form}}}
</div>
