{{!
    @template tool_wp/processing_indicator

    Template for showing an overlay on a container to indicate a action is
    being processed.

    Classes required for JS:
    * tool-wp-processing

    Data attibutes required for JS:
    * None

    Context variables required for this template:
    * None

    Example context (json):
    {
    }
}}
<div class="tool-wp-processing">
    <div class="tool-wp-processing-backdrop"></div>
    <i class="fa fa-spinner fa-spin fa-3x fa-fw"></i>
    <span class="sr-only">{{#str}} processing, tool_wp {{/str}}</span>
</div>
