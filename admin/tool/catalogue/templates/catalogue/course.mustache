{{!
    @template tool_catalogue/catalogue/course

    One couse in the catalogue.

    Example context (json):
    {
        "title": "Course 1",
        "image": "http://placekitten.com/250/150",
        "url": "http://example.com/course/view.php?id=2",
        "fields": [
            {
                "fieldname": "summary",
                "label": "Summary",
                "content": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque suscipit nunc nibh, in rhoncus neque fringilla id. Ut a vehicula est. Curabitur semper iaculis fermentum. Sed sed nisl a nunc pretium vulputate. Quisque cursus risus mattis sapien blandit ultricies. Integer semper nisl id ante vestibulum feugiat. Vestibulum sed mi justo.",
                "isempty": 0,
                "showlabel": 0,
                "issummary": 1
            },
            {
                "fieldname": "customfield_somefield",
                "label": "Custom field",
                "content": "Hello there",
                "isempty": 0,
                "showlabel": 1,
                "iscustomfield": 1
            }
        ]
    }
}}
<div class="tool_catalogue_course">
    <div class="tool_catalogue_course_image position-relative">
        <a href="{{url}}">
            <img src="{{image}}" alt="{{title}}" class="w-100 h-100"/>
        </a>
    </div>
    <div class="tool_catalogue_course_body">
        <div class="tool_catalogue_course_title">
            <a href="{{url}}" class="text-primary">{{{title}}}</a>
        </div>
        {{#fields}}
            {{> tool_catalogue/catalogue/course_field }}
        {{/fields}}
    </div>
</div>