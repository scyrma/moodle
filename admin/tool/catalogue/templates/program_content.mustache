{{!
    @template tool_catalogue/program_content

    Template for showing a program content page.

    Example context (json):
    {
        "fullname": "Health and Safety",
        "completionicon": "https://placekitten.com/10/10",
        "recentlyaccessedcourses": [
            {
                "name": "Advanced advises regarding body posture Advanced advises regarding body posture",
                "courseimage": "http://placekitten.com/300/300",
                "progress": "50"
            },
            {
                "name": "Introduction to health and safety at work",
                "courseimage": "http://placekitten.com/320/320",
                "progress": "60"
            },
            {
                "name": "Use more of your time in the classroom",
                "courseimage": "http://placekitten.com/350/350",
                "progress": "60"
            }
        ],
        "completioncriteria": "<span class=\"mr-1\"><strong>To-do: </strong></span> Complete everything in order",
        "completionprogress": "1 of 5 completed",
        "setid": 0,
        "listitems": [
            {
                "isset": false,
                "image": "http://placekitten.com/350/350",
                "fullname": "Introducation to Health and Safety at work",
                "progress": 100
            }
        ]
    }
}}
<div id="program-container" data-region="program-container" class="catalogue program" data-programid="{{programid}}" data-fullname="{{{fullname}}}">
    <div class="level d-none" data-region="program-heading" data-setid="0">
        {{#hasrecentlyaccessedcourses}}
        {{< tool_catalogue/cover/pagesection }}
            {{$name}}{{#str}}recentlyaccessedcourses, tool_catalogue{{/str}}{{/name}}
            {{$shortname}}p-recent{{/shortname}}
            {{$content}}
                <div class="card-deck dashboard-card-deck my-2" role="list">
                {{#recentlyaccessedcourses}}
                    <div class="card dashboard-card position-relative" role="listitem">
                        <div class="card-img program-card-img" style='background-image: url("{{{courseimage}}}");'>
                            <span class="sr-only">{{#str}}aria:courseimage, core_course{{/str}}</span>
                        </div>
                        <div class="card-body p-2">
                            <div class="d-flex">
                                <a href="{{viewurl}}" class="aalink link-stretched">
                                    {{{name}}}
                                </a>
                            </div>
                        </div>
                        <div class="p-2 text-muted font-medium">
                            {{#str}}progress, tool_catalogue, {{{progress}}}{{/str}}
                        </div>
                    </div>
                {{/recentlyaccessedcourses}}
                </div>
            {{/content}}
        {{/ tool_catalogue/cover/pagesection }}
        {{/hasrecentlyaccessedcourses}}
        <div class="d-flex">
            <span class="mr-1 d-flex align-items-center">
                <span class="completionsvg mr-2" aria-hidden="true">
                    <img src="{{{completionicon}}}" alt="">
                </span>
                <span class="mr-1"><strong>{{#str}}todo, tool_catalogue{{/str}}</strong></span>
                {{{completioncriteria}}}
            </span>
            <span class="ml-auto text-muted">{{{completionprogress}}}</span>
        </div>
        <hr>
    </div>
    {{#listitems}}
        {{> tool_catalogue/listitems/item}}
    {{/listitems}}
</div>
{{#js}}
require(['tool_catalogue/programcontent'], function(programContent) {
    programContent.init({{#navitems}}JSON.parse('{{{navitems}}}'){{/navitems}});
});
{{/js}}
