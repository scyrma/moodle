{{!
    @template tool_tenant/active_tenants_list

    Template for showing list of tenants

    Example context (json):
    {
        "tabheading": "Active tenants",
        "addbuttontitle": "Add tenant",
        "columns": [
            {"class": "col-9", "content": "Name"},
            {"class": "col-3", "content": "Actions"}
        ],
        "canhavechildren": true,
        "children": [
            {
                "columns": [
                    {"class": "col-9", "content": "Node 1"},
                    {"class": "col-3", "content": "[X]"}
                ],
                "canhavechildren": false
            }
        ]
    }
}}

{{> tool_wp/tab_heading }}
<div id="activetenantstable">
{{> tool_wp/table_tree }}
</div>
{{#js}}
    require(['tool_tenant/manage'], function(Manage) {
        Manage.init('#activetenantstable .tool-wp-table-tree .tool-wp-children');
    });
{{/js}}