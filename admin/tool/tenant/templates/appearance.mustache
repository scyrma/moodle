{{!
    @template tool_tenant/appearance

    Template for editing tenant theme settings

    Example context (json):
    {
        "tabheading": "Appearance",
        "formclass": "some\\class",
        "form": "Form contents"
    }
}}

{{> tool_wp/tab_heading }}
{{> tool_wp/tab_form }}
{{#js}}
    require(['tool_wp/tabs', 'tool_wp/notification', 'core/str'], function(Tabs, WpNotification, Str) {
        Tabs.initForm(function() {
            window.scrollTo(0, 0);
            Str.get_string('themesettingssaved', 'tool_tenant')
                .then(function(string) {
                    WpNotification.addNotification({
                        message: string,
                        type: 'success'
                    });
                    return null;
                })
                .fail(WpNotification.exception);
        });
    });
{{/js}}
