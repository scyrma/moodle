{{!
    @template tool_reportbuilder/no-filters

    This template renders the no columns message.

    Classes required for JS:
    -
    Data attributes required for JS:
    -
    Context variables required for this template:
    -

    Example context (json):
    {
        "nocolumnsurl": "https://moodlesite/theme/image.php/workplace/tool_reportbuilder/1535727318/no-filters"
    }
}}
<div class="d-flex justify-content-center">
    <div class="text-xs-center text-center mt-3" data-region="empty-message">
        <img height="50" src="{{nocolumnsurl}}"
         alt="{{#str}} nocolumnsselected, tool_reportbuilder {{/str}}"
         role="presentation">
        <p class="text-muted m-t-1">{{# str }} nocolumnsselected, tool_reportbuilder {{/ str }}</p>
    </div>
</div>