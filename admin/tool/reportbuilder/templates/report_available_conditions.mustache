{{!
    @template tool_reportbuilder/report_available_conditions

    Template for the list of avialable conditions

    Classes required for JS:
    -
    Data attributes required for JS:
    -
    Context variables required for this template:
    -

    Example context (json):
    {
        "hasavailableconditions": 1,
        "show": 1,
        "availableconditions":[
            {
                "optiongroup":{
                    "text":"Entity 1",
                    "values":[
                        {
                            "value":"value1",
                            "selected":false,
                            "visiblename":"Field 1"
                        }
                    ]
                }
            }
        ]
    }
}}

<div class="tool_reportbuilder_report_available_conditions" data-region="available-conditions">
    {{# hasavailableconditions}}
        <label for="addconditonselect" class="sr-only">{{#str}} selectacondition, tool_reportbuilder {{/str}}</label>
        <select id="addconditonselect" name="addconditonselect" class="custom-select js-add-condition-select large-multiple-select">
            <option value="0">{{#str}}addacondition, tool_reportbuilder{{/str}}</option>
            {{# availableconditions}}
                {{# optiongroup}}
                    <optgroup label="{{text}}">
                        {{# values}}
                            <option value="{{value}}">{{visiblename}}</option>
                        {{/ values}}
                    </optgroup>
                {{/ optiongroup}}
            {{/ availableconditions}}
        </select>
    {{/ hasavailableconditions}}
</div>