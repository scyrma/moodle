{{!
    @template tool_reportbuilder/report_sidebar_columns_area

   Template for the sidebar columns area in the report builder editor

     Classes required for JS:
    -
     Data attributes required for JS:
    -
    Context variables required for this template:


     Example context (json):
    {
        "availablecolumns": 1,
        "optiongroup": [
            {
                "text": "Course completion",
                "key": "coursecompletion",
                "values": [
                    {
                        "value": "course:course:fullname",
                        "selected": false,
                        "visiblename": "Full name"
                    }
                ]
            }
        ]
    }
}}
<div class="js-draggable-columns tool_reportbuilder_report_sidebar_columns_area" data-region="columns">
    {{#availablecolumns}}
        {{#optiongroup}}
            {{>tool_reportbuilder/report_columns}}
        {{/optiongroup}}
    {{/availablecolumns}}
</div>