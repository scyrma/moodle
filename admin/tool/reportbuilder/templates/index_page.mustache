{{!
    @template tool_reportbuilder/index_page

    Reportbuilder index_page template.

    The purpose of this template is to render the tabs for reports and schedules.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * dataattributes array Attributes to add to the wrapper of tabs.
    * showtabsnavigation int If the tabs need to be show.
    * tabs array Tabs to show:
        * shortname string.
        * displayname string Visible name of the tab.
        * content srting The tab content.
        * enabled bool If the tab is enabled.

    Example context (json):
    {
        "dataattributes": [ ],
        "showtabsnavigation": "1",
        "tabs": [
            {
                "shortname": "tab1",
                "displayname": "Tab 1",
                "content": "Content of tab 1",
                "enabled": 1
            },
            {
                "shortname": "tab2",
                "displayname": "Tab 2",
                "content": "Content of tab 2",
                "enabled": 0
            }
        ]
    }

}}

<div class="tool_reportbuilder_index_page">
    {{> tool_wp/tabs }}
</div>