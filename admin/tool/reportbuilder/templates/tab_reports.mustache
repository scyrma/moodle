{{!
    @template tool_reportbuilder/tab_reports

    Reportbuilder tab_reports template.

    The purpose of this template is to render a list a reports.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * content string The table with the report renderer.
    * addbuttontitle string The title of the button for add a new report.

    Example context (json):
    {
      "content": "The table content goes here",
      "addbuttontitle": "Add",
      "tabheading": "Reports"
    }

}}
<div class="tool_reportbuilder_tab_reports" data-region="reports-list">
    {{> tool_wp/tab_heading }}
    {{{content}}}
</div>
{{#js}}
    M.util.js_pending('tool_reportbuilder_reports_manager');
    require(['tool_reportbuilder/reports_manager'],
        function(ReportsManager) {
            new ReportsManager('[data-region="reports-list"]');
            M.util.js_complete('tool_reportbuilder_reports_manager');
        }
    );
{{/js}}