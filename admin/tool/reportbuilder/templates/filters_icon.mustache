{{!
    @template tool_reportbuilder/filters_icon

    Filters icon.

    Example context (json):
    {
    }
}}
<div class="text-right filters-icon px-0">
    <button id="reportbuilder-filters-collapse" data-toggle="collapse" data-target="#filters" class="btn btn-sm btn-outline-secondary" title="{{#str}} filtersbutton, tool_reportbuilder {{/str}}">
        {{#pix}} a/wp-filter, theme {{/pix}}
        {{#str}} filtershelp, tool_reportbuilder {{/str}}
        <span class="badge badge-danger js-filters-active filters-count invisible"></span>
    </button>
</div>