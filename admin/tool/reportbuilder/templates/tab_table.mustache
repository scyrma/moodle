{{!
    @template tool_reportbuilder/tab_table

    Template for the report tab

    Classes required for JS:
    -

    Data attributes required for JS:
    * data-region

    Context variables required for this template:

    Example context (json):
    {
        "reportid": 1,
        "ispreview": "false",
        "table": "",
        "hascolumns": "false",
        "hassidebar": "true",
        "name": "example",
        "editon": true,
        "conditionshelp": true,
        "filtershelp": true,
        "sortinghelp": true,
        "nofiltersurl": "https://via.placeholder.com/150?text=No+filters",
        "nocolumnsurl": "https://via.placeholder.com/150?text=No+sorting",
        "noconditionsurl": "https://via.placeholder.com/150?text=No+conditions",
        "canaddfilters": true,
        "tabheading": "Table"
    }
}}
<div class="w-100 tool_reportbuilder_tab_table" data-region="report-builder" data-reportid="{{reportid}}" {{^ispreview}}data-editon="1"{{/ispreview}}>
        {{> tool_wp/tab_heading }}
    <div class="row h-100 no-gutters fit-container">
        {{# hascolumns}}
            <div data-region="sidebar-columns" class="col-4 col-lg-3 pr-2 d-flex flex-column fill-column columns-wrapper">
                <div class="flex-1 overflow-hidden min-height">
                    <div class="position-absolute w-100 pr-md-2 scroll-y">
                        <div class="h-100 scroll-y">
                            {{> tool_reportbuilder/report_sidebar_columns}}
                        </div>
                    </div>
                </div>
            </div>
        {{/ hascolumns}}
        <div class="col-8 d-flex flex-column fill-column {{^ispreview}}col-lg-9{{/ispreview}}{{#ispreview}}col-12{{/ispreview}}">
            <div class="flex-1 overflow-hidden min-height">
                <div class="{{^ispreview}}position-absolute{{/ispreview}} w-100 px-md-2 scroll-y">
                    <div id="conditions-container" class="h-100 d-flex scroll-y">
                        <div class="card flex-fill no-overflow">
                            <div class="card-header d-flex">
                                <h4 class="mb-0">{{{name}}}</h4>
                                <div class="ml-auto d-flex align-items-center">
                                    {{^ispreview}}
                                        <button data-action="show-preview" class="btn btn-link nomargin">
                                            {{# pix }} i/hide, core, {{#str}} previewmode, tool_reportbuilder {{/str}} {{/ pix }}
                                            <span class="sr-only">{{#str}} previewmode, tool_reportbuilder {{/str}}</span>
                                        </button>
                                        {{> tool_reportbuilder/filters_icon}}
                                    {{/ispreview}}
                                    {{#ispreview}}
                                        <button data-action="show-edit" class="btn btn-link nomargin">
                                            {{# pix }} t/editstring, core, {{#str}} editmode, tool_reportbuilder {{/str}} {{/ pix }}
                                            <span class="sr-only">{{#str}} editmode, tool_reportbuilder {{/str}}</span>
                                        </button>
                                       {{#hasfiltersselected}}
                                           {{> tool_reportbuilder/filters_icon}}
                                       {{/hasfiltersselected}}
                                    {{/ispreview}}
                                </div>
                            </div>
                            <div class="card-body p-2 bg-white">
                                <div class="table-responsive position-relative" data-region="data-report" data-parameters="{{parameters}}">
                                    {{{table}}}
                                </div>
                            </div>
                        </div>
                        {{# hassidebar}}
                            {{> tool_reportbuilder/report_sidebar_filters}}
                        {{/ hassidebar}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{#js}}
    M.util.js_pending('tool_reportbuilder_tab_table');
    require(['tool_reportbuilder/reportbuilder'],
        function() {
            M.util.js_complete('tool_reportbuilder_tab_table');
        }
    );
{{/js}}