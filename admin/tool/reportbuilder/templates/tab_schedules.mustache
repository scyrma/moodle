{{!
    @template tool_reportbuilder/tab_schedules

    Tool reportbuilder tab_schedules template.

    The purpose of this template is to render the tab schedules content.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region Required for the schedules manager component

    Context variables required for this template:
    * content string The table with the schedules.

    Example context (json):
    {
      "content": "The table content goes here",
      "addbuttontitle": "Add",
      "reportid": 0,
      "tabheading": "Schedules"
    }

}}
<div class="tool_reportbuilder_tab_schedules" data-region="schedules-list">
    {{> tool_wp/tab_heading }}
    {{{content}}}
</div>
{{#js}}
    M.util.js_pending('tool_reportbuilder_schedules_manager');
    require(['tool_reportbuilder/schedules_manager'],
        function(SchedulesManager) {
            new SchedulesManager('[data-region="schedules-list"]', {{reportid}});
            M.util.js_complete('tool_reportbuilder_schedules_manager');
        }
    );
{{/js}}