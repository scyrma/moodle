{{!
  @template tool_reportbuilder/tab_details

  The content for tab detail with the form.

  The purpose of this template is to render the form for the details of the report.

  Classes required for JS:
  * none

  Data attributes required for JS:
  * none

  Context variables required for this template:
  * form The renderer form.
  * reportid The report id.

  Example context (json):
  {
      "form": "The form goes here",
      "reportid": 1,
      "tabheading": "Details"
  }

}}
<div class="tool_reportbuilder_tab_details">
    {{> tool_wp/tab_heading }}
    {{{form}}}
</div>
{{#js}}
    M.util.js_pending('tool_reportbuilder_init');
    require(['tool_reportbuilder/reportbuilder'],
        function() {
            M.util.js_complete('tool_reportbuilder_init');
        }
    );
{{/js}}