{{!
    @template tool_reportbuilder/report_view
     Template for show a report.
     Classes required for JS:
    -
     Data attributes required for JS:
    -
    Context variables required for this template:

     Example context (json):
    {
        "id": "1",
        "table": "",
        "hassidebar": false,
        "name": "Example report"

    }
}}
<div class="tool_reportbuilder_report_view tool_reportbuilder_report report" data-view data-region="report-builder" data-reportid="{{id}}" data-source="{{source}}">
    <div class="d-flex flex-nowrap p-2 w-100">
        <div class="p-2 w-100 no-overflow">
            <div class="d-flex justify-content-between">
                <h4>
                    {{{name}}}
                </h4>
                {{#hasfiltersselected}}
                    {{> tool_reportbuilder/filters_icon}}
                {{/hasfiltersselected}}
            </div>
            <div class="table-responsive position-relative" data-region="data-report" data-parameters="{{parameters}}">
                {{{table}}}
            </div>
        </div>
        {{# hassidebar}}
            {{> tool_reportbuilder/report_sidebar_filters}}
        {{/ hassidebar}}
    </div>
</div>
{{#js}}
    M.util.js_pending('tool_reportbuilder_report_view');
    require(['tool_reportbuilder/reportbuilder'],
        function() {
        M.util.js_complete('tool_reportbuilder_report_view');
        }
    );
{{/js}}