{{!
    @template tool_reportbuilder/filter_card

    Filters card.

    Example context (json):
    {
        "editing": false,
        "id": 123,
        "label": "Surname",
        "start": true,
        "end": true
    }
}}
<!--Filter card start html-->
{{#start}}
<div class="reportbuilder-card mb-2 pb-2" data-id="{{id}}" data-type="{{filtertype}}">
    <div class="d-flex align-items-start justify-content-between mb-2" data-active="{{active}}">
    <!-- Report settings conditions content -->
    {{#editing}}
        <div class="filter-name">
            {{{inplaceeditable}}}
        </div>
        <span class="text-right d-flex align-items-center">
            <a href="#" class="mr-2 pr-2 border-right" role="button" data-action="reset-filter" data-id="{{id}}" data-field="{{label}}" title="{{#str}} resetfield, tool_reportbuilder, {{label}} {{/str}}">
                {{#str}} reset {{/str}}
            </a>
            <a href="#" data-action="delete-condition" data-id="{{id}}" data-name="{{label}}" title="{{#str}}deletecondition, tool_reportbuilder, {{label}}{{/str}}">
                {{#pix}}i/trash, core{{/pix}}
            </a>
        </span>
    {{/editing}}
    <!-- Report sidebar content -->
    {{^editing}}
        <div class="filter-name">
            {{label}}
        </div>
        <button class="btn btn-link" data-action="reset-filter" data-id="{{id}}" title="{{#str}} resetfield, tool_reportbuilder, {{label}} {{/str}}">
            {{#str}} reset {{/str}}
        </button>
    {{/editing}}
    </div>
    <div class="" data-id="{{id}}">
{{/start}}

<!--Filter card end html -->
{{#end}}
    </div>
</div>
{{/end}}