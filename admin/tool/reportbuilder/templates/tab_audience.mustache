{{!
  @template tool_reportbuilder/tab_audience

  Audience tab template.

  Example context (json):
  {
    "tabheading": "Audience"
  }

}}
<div class="tool_reportbuilder_tab_audience">
    {{> tool_wp/tab_heading }}
    {{> tool_wp/tab_form }}
</div>
{{#js}}
    require([
        'tool_wp/tabs', 'tool_wp/notification', 'core/str', 'core/notification'
    ], function(Tabs, WpNotification, Str, Notification) {
        Tabs.initForm(function(data) {
            if (data === true) {
                Str.get_string('changessaved').then(function(string) {
                    WpNotification.addNotification({
                        type: 'success',
                        message: string
                    });

                    Tabs.loadTab();

                    return;
                }).fail(Notification.exception);
            }
        });
    });
{{/js}}