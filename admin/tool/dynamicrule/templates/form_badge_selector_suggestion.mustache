{{!
    @template tool_dynamicrule/form_badge_selector_suggestion

    Template for showing badge selector list.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * id Badge ID field
    * name Badge name

    Example context (json):
    {
        "id": "1",
        "name": "Badge 1024"
    }
}}
<span>{{name}}</span>
