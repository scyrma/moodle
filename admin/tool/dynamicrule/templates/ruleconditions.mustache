{{!
    @template tool_dynamicrule/ruleconditions

    Template for showing rule conditions form.

    Example context (json):
    {
        "tabheading": "Conditions",
        "menucards": [],
        "instances": [],
        "noinstances": "1",
        "noinstancesurl": "https://moodlesite/theme/image.php/workplace/tool_dynamicrule/1561379437/no-instance",
        "addinstancesstr": "Add conditions to this rule"
    }
}}
{{> tool_dynamicrule/rule_heading}}
<div class="row h-100 no-gutters fit-container">
    <div class="col-4 d-flex flex-column fill-column" id="conditions-menu">
        <div class="flex-1 overflow-hidden min-height">
            <div class="position-absolute w-100 pr-md-2 scroll-y">
                <div class="h-100 scroll-y">
                {{#menucards}}
                    {{> tool_dynamicrule/menucard}}
                {{/menucards}}
                </div>
            </div>
        </div>
    </div>
    <div id="scroller" class="col-8 d-flex flex-column fill-column">
        <div id="scroller-inner" class="flex-1 overflow-hidden min-height">
            <div class="position-absolute w-100 pl-md-2 scroll-y">
                <div id="conditions-container" class="h-100 scroll-y">
                    {{> tool_dynamicrule/no_instances}}
                    {{#instances}}
                        {{> tool_dynamicrule/form_instance}}
                    {{/instances}}
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12 text-right">
      <span id="matching-users-counter">{{{countmatchingusers}}}</span>
      <a href="#" id="viewmatchingusers">{{#str}} viewmatchingusers, tool_dynamicrule {{/str}}</a>
    </div>
</div>

{{#js}}
    require(['tool_dynamicrule/edit_rule'], function(editRule) {
        editRule.init();
    });
{{/js}}
