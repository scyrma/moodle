{{!
    @template tool_dynamicrule/conditions_menucard

    Template for showing rule conditions menu card.

    Example context (json):
    {
        "categoryid": "dynamicrules",
        "categorytitle": "Dynamic Rules",
        "menucarditems": [{
            "title": "User profile",
            "configclass": "tool_dynamicrule:user_profile_field",
            "addlabel": "Add condition"
        }]
    }
}}

<div id="workplace-accordion" class="mb-3">
    <div class="card">
        <div class="card-header p-0" id="{{categoryid}}-heading">
            <h5 class="mb-0">
                <button class="btn btn-link btn-block text-left ws-toggle nomargin ml-1" data-toggle="collapse" data-target="#{{categoryid}}" aria-expanded="true" aria-controls="{{categoryid}}">
                    <span class="togglesectionicon collapsed-icon-container">
                        {{#pix}} t/collapsedcaret, core, {{#str}} expand, moodle {{/str}}{{/pix}}
                    </span>
                    <span class="togglesectionicon expanded-icon-container">
                        {{#pix}} t/expanded, core, {{#str}} collapse, moodle {{/str}}{{/pix}}
                    </span>
                    {{categorytitle}}
                </button>
            </h5>
        </div>
        <div id="{{categoryid}}" class="collapse show" aria-labelledby="{{categoryid}}-heading">
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    {{#menucarditems}}
                        {{#isavailable}}
                        <a href="#" class="list-group-item list-group-item-action d-flex align-items-start pr-2" data-configclass="{{configclass}}" data-isscheduledtask="{{isscheduledtask}}" title="{{title}}">
                            {{title}}
                            <span class="ml-auto">
                                {{#pix}}t/add, core, {{addlabel}} {{/pix}}
                            </span>
                        </a>
                        {{/isavailable}}
                        {{^isavailable}}
                        <span class="list-group-item list-group-item-action d-flex align-items-start pr-2 text-muted" title="{{title}}">
                            {{title}}
                            <span class="ml-auto">
                                {{#pix}}info-circle, tool_wp, {{notavailablelabel}} {{/pix}}
                            </span>
                        </span>
                        {{/isavailable}}
                    {{/menucarditems}}
                </div>
            </div>
        </div>
    </div>
</div>
