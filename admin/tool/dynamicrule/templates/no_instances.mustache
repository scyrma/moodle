{{!
    @template tool_dynamicrule/no_entities

    This template renders the no columns message.

    Example context (json):
    {
        "noinstances": "1",
        "noinstancesurl": "https://moodlesite/theme/image.php/workplace/tool_dynamicrule/1561379437/no-instance",
        "addinstancesstr": "Add conditions to this rule"
    }
}}
<div class="justify-content-center card p-5 {{^noinstances}}hidden{{/noinstances}}" data-region="empty-message">
    <div class="text-xs-center text-center mt-3">
        <img height="50" src="{{noinstancesurl}}" alt="{{addinstancesstr}}" role="presentation">
        <p class="text-muted m-t-1">{{addinstancesstr}}</p>
    </div>
</div>
