{{!
    @template tool_dynamicrule/rules_list_item_description

    Template for showing description for rule conditions or outcomes in rules listing interface.

    Example context (json):
    {
        "instances": []
    }
}}
<ul>
    {{#instances}}
    <li>{{description}}{{#isbroken}}<span class="badge badge-warning broken m-l-1" title="{{brokenlabel}}">{{#str}} error {{/str}}</span>{{/isbroken}}</li>
    {{/instances}}
</ul>
