{{!
    @template tool_certification/archived_certifications_list

    Template for showing list of certifictaions

    Example context (json):
    {
        "certificationsarchivedlisttable": "<table></table>",
        "tabheading": "Archived certifications"
    }
}}
<div class="tool_certification_archive_certifications_list" data-region="archive-certifications">
    {{> tool_wp/tab_heading }}
    {{{certificationsarchivedlisttable}}}
</div>
{{#js}}
    require(['tool_certification/certification_manager'], function(CertsManager) {
    new CertsManager('[data-region="archive-certifications"]');
    }
    );
{{/js}}