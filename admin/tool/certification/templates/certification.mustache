{{!
    @template tool_certification/certification

    Template for showing edit details button on edit certification

    Example context (json):
    {
        "tabheading": "Active certifications",
        "addbuttontitle": "Add new certification"
    }
}}
<div class="tool_certification_tabs_list">
    {{> tool_wp/tabs }}
</div>
{{#js}}
    M.util.js_pending('tool_certification_edit');
    require(['tool_certification/edit_details'],
    function(Certification) {
        new Certification();
        M.util.js_complete('tool_certification_edit');
    });
{{/js}}