{{!
    @template tool_certification/edit_certification_calendar

    Template for showing certification details.

    Example context (json):
    {
        "completionform": "htmlcode"
    }
}}
{{> tool_wp/tab_heading }}
{{> tool_wp/tab_form }}
{{#js}}
    require([
        'tool_wp/tabs',
        'core/notification',
        'tool_wp/notification',
        'core/str'
    ], function(Tabs, Notification, WpNotification, Str) {
        Tabs.initForm(function(data) {
            if (data === true) {
                Str.get_string('scheduleupdatesuccess', 'tool_certification')
                    .then(function(string) {
                        WpNotification.addNotification({
                            message: string,
                            type: 'success'
                        });
                        return null;
                    })
                    .fail(Notification.exception);
            }
        });
    });
{{/js}}
