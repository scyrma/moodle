<div id="moodlecloud-notification-area"></div>

<div class="text-xs-center text-center m-t-3" id="moodlecloud-notifications-empty" style="display: none;">
    <img class="empty-placeholder-image-lg"
         src="{{urls.nocourses}}"
         alt="{{#str}} nocoursesinprogress, block_myoverview {{/str}}"
         role="presentation"
         style="height: 125px;"
    >
    <p class="text-muted m-t-1">{{#str}} nonotifications, local_moodlecloud {{/str}}</p>
</div>

{{#js}}
    require(['jquery', 'local_moodlecloud/notification_area_controller'], function($, controller) {
        controller.init($('#moodlecloud-notification-area'));
    });
{{/js}}
