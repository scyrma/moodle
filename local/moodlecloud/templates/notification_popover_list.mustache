<div>
    {{#notifications}}
        <div class="content-item-container notification {{^read}}unread{{/read}}"
             data-region="notification-content-item-container"
             data-id="{{id}}"
             role="listitem">

            {{#contexturl}}
                <a class="context-link" href="{{{.}}}" data-action="content-item-link"
            {{/contexturl}}

            {{^contexturl}}
                <div tabindex="0"
            {{/contexturl}}
            {{#read}}aria-label="{{name}}"{{/read}}
            {{^read}}aria-label="{{#str}} unreadnotification, message, {{name}} {{/str}}"{{/read}}>

            <div class="content-item-body">
                <div class="notification-message">{{name}}</div>
            </div>

            {{#viewmoreurl}}
                <a href="{{{.}}}" class="view-more" data-action="view-more">{{#str}} viewnotification, moodlecloud {{/str}}</a>
            {{/viewmoreurl}}
            {{#contexturl}}
                </a>
            {{/contexturl}}
            {{^contexturl}}
                </div>
            {{/contexturl}}
        </div>
    {{/notifications}}
</div>
