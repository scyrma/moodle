{{< core/popover_region }}
    {{$classes}}popover-region-quotas {{theme}}{{/classes}}
    {{$attributes}}id="nav-moodlecloud-quota-popover-container" data-userid="{{userid}}"{{/attributes}}

    {{$togglelabel}}{{#str}} shownotificationwindownonew, message {{/str}}{{/togglelabel}}
{{$togglecontent}}
        <div>
            <span class="progresslabel">{{#str}}users, local_moodlecloud{{/str}}</span>
            <progress id="progressbar" max="1" value="{{userpercentage}}" class="{{userpercentagestatus}}"></progress>
        </div>

        <div>
            <span class="progresslabel">{{#str}}storage, local_moodlecloud{{/str}}</span>
            <progress id="progressbar" max="1" value="{{storagepercentage}}" class="{{storagepercentagestatus}}"></progress>
        </div>
    {{/togglecontent}}

    {{$containerlabel}}{{#str}} notificationwindow, message {{/str}}{{/containerlabel}}

    {{$headertext}}{{#str}} moodlecloudquotas, local_moodlecloud {{/str}}{{/headertext}}
    {{$headeractions}}{{/headeractions}}

    {{$content}}
    <div class="items">
        <div class="item users">
            <h2>{{users}}/{{totalusers}}</h2>
            <h3>{{#str}} users, local_moodlecloud {{/str}}</h3>
            <svg width="160" height="160" xmlns="http://www.w3.org/2000/svg">
                <g>
                    <circle
                        id="circle"
                        style="stroke-dashoffset: 0;"
                        class="circle_animation"
                        r="69.85699"
                        cy="81"
                        cx="81"
                        stroke-width="20"
                        stroke="#dddddd"
                        fill="none"
                    />
                    <circle
                        id="circle"
                        style="stroke-dashoffset: calc(440 * (1 - {{userpercentage}}));"
                        class="circle_animation"
                        r="69.85699"
                        cy="81"
                        cx="81"
                        stroke-width="19"
                        stroke="#ff7518"
                        fill="none"
                    />
                </g>
            </svg>
        </div>

        <div class="item storage">
            <h2>{{mb}}/{{totalmb}}</h2>
            <h3>{{#str}} mbused, local_moodlecloud {{/str}}</h3>
            <svg width="160" height="160" xmlns="http://www.w3.org/2000/svg">
                <g>
                    <circle
                        id="circle"
                        style="stroke-dashoffset: 0;"
                        class="circle_animation"
                        r="69.85699"
                        cy="81"
                        cx="81"
                        stroke-width="20"
                        stroke="#dddddd"
                        fill="none"
                    />
                    <circle
                        id="circle"
                        style="stroke-dashoffset: calc(440 * (1 - {{storagepercentage}}));"
                        class="circle_animation"
                        r="69.85699"
                        cy="81"
                        cx="81"
                        stroke-width="19"
                        stroke="#ff7518"
                        fill="none"
                    />
                </g>
            </svg>
        </div>
    </div>
    {{/content}}
{{/ core/popover_region }}

{{#js}}
    require(['jquery', 'local_moodlecloud/quota_popover_controller'], function($, controller) {
        var controller = new controller($('#nav-moodlecloud-quota-popover-container'));
    });
{{/js}}
