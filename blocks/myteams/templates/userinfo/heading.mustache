{{!
    @template block_myteams/userinfo/heading

    Heading user information for My Teams block.

    Context variables required for this template:

    Example context (json):
    {
        "fullnamewithpicture": "<div><span class='userinitials size-35'>U1</span>User 1</div>",
        "lastaccess": "5 hours 9 mins",
        "lastaccessdate": "02/09/2022, 11:18",
        "isoverdue": true
    }
}}
<div class="d-flex align-items-center">
    {{{fullnamewithpicture}}}
</div>
{{#isoverdue}}
    <div class="d-flex align-items-center ml-2 icon-no-margin text-danger icon-size-2">
        {{#pix}}i/item, core {{/pix}}
    </div>
{{/isoverdue}}
<div class="ml-auto d-flex flex-column text-right">
    <span class="text-uppercase font-small text-gray-700">{{#str}} lastaccess, core {{/str}}</span>
    <span class="text-right font-small z-index-1">
        {{lastaccess}}
        <button
            class="text-info btn p-0 icon-no-margin"
            data-toggle="tooltip"
            data-region="block_myteams-lastaccessdate"
            data-placement="right"
            title="{{lastaccessdate}}"
        >
            {{#pix}}info-circle, tool_wp{{/pix}}
            <span class="sr-only">{{#str}} lastaccess, core {{/str}}</span>
        </button>
    </span>
</div>