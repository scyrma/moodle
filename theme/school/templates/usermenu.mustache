<div class="usermenu" tabindex="0" role="menu" aria-label="{{#str}} usermenu {{/str}}" aria-expanded="false" aria-controls="user-menu-items">
    <ul class="menubar menubars">
        <li>
            <div class="clickable">
                <span class="userbutton">
                    <span>
                        <span class="avatar current">
                            {{{ user_profile_picture }}}
                        </span>
                    </span>
                    <span>
                        {{ firstname }}
                        <span>
                            {{ lastname }}
                            <i class="fa fa-chevron-circle-down"></i>
                        </span>
                    </span>
                </span>
            </div>
        </li>
    </ul>
    <ul id="user-menu-items" class="menu menulist">
        {{# menuitems }}
            {{> theme_school/usermenu_item_link }}
        {{/ menuitems }}
    </ul>
</div>
