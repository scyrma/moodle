{{!
    Frontpage static.
}}

{{#isadmin}}
    <div class="clear"></div>
    <div id="frontpage-edit-button">
        <a class="btn btn-primary" href="{{{frontpagesiteadminurl}}}">{{#str}} siteadministration, theme_school {{/str}}</a>
        <a class="btn btn-primary" href="{{{frontpagesettingsurl}}}">{{#str}} updatemymoodleon {{/str}}</a>
    </div>
{{/isadmin}}
<section id="region-main-static" class="hero-unit static col-md-12 py-3">
    <div class="content-wrap">
    <div class="container">
        <div class="row-fluid">
            {{^left}}
                <div class="{{#hasmedia}}col-md-6{{/hasmedia}}
                    {{^hasmedia}}col-md-12{{/hasmedia}}
                               static-content-align">{{{text}}}</div>
            {{/left}}
            {{#hasmedia}}
                {{#image}}
                    {{#image}}
                        <div class="col-md-6 static-content-align">
                            <img class="mw-100" src="{{{image}}}" alt="{{#str}} staticimagealt, theme_school {{/str}}" />
                        </div>
                    {{/image}}
                {{/image}}
                {{^image}}
                    {{#videourl}}
                        {{#videourl}}
                            <div class="col-md-6 static-content-align">{{{videourl}}}</div>
                        {{/videourl}}
                    {{/videourl}}
                    {{^videourl}}
                        {{#video}}
                            <div class="col-md-6 static-content-align">
                                <video width="560" height="315" controls>
                                    <source src="{{{video}}}" type="video/mp4">
                                </video>
                            </div>
                        {{/video}}
                    {{/videourl}}
                {{/image}}
            {{/hasmedia}}
            {{#left}}
                <div class="{{#hasmedia}}col-md-6{{/hasmedia}}
                    {{^hasmedia}}col-md-12{{/hasmedia}}
                               static-content-align">{{{text}}}</div>
            {{/left}}
        </div>
    </div>
    </div>
</section>
