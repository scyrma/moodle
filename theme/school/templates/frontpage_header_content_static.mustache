{{#isadmin}}
    <div class="clear"></div>
    <div id="frontpage-edit-button">
        <a class="btn btn-primary" href="{{{frontpagesiteadminurl}}}">{{#str}} siteadministration, theme_school {{/str}}</a>
        <a class="btn btn-primary" href="{{{frontpagesettingsurl}}}">{{#str}} updatemymoodleon {{/str}}</a>
    </div>
{{/isadmin}}
{{#hascontent}}
    <div class="welcome-block">
        <div class="container">
            <div class="row">
                {{^mediaalignleft}}
                    <div class="{{#hasmedia}}col-md-6{{/hasmedia}}
                                {{^hasmedia}}col-md-12{{/hasmedia}}
                                static-content-align">{{{text}}}</div>
                {{/mediaalignleft}}
                {{#hasmedia}}
                    {{#mediaimage}}
                            {{#imageurl}}
                                <div class="col-md-6 static-content-align">
                                    <img src="{{{.}}}" alt="{{#str}} staticimagealt, theme_school {{/str}}" />
                                </div>
                            {{/imageurl}}
                    {{/mediaimage}}
                    {{^mediaimage}}
                        {{#iframevideo}}
                            {{#iframehtml}}
                                <div class="col-md-6 static-content-align">{{{.}}}</div>
                            {{/iframehtml}}
                        {{/iframevideo}}
                        {{^iframevideo}}
                            {{#videosrc}}
                                <div class="col-md-6 static-content-align">
                                    <video width="560" height="315" controls>
                                        <source src="{{{.}}}" type="video/mp4">
                                    </video>
                                </div>
                            {{/videosrc}}
                        {{/iframevideo}}
                    {{/mediaimage}}
                {{/hasmedia}}
                {{#mediaalignleft}}
                    <div class="{{#hasmedia}}col-md-6{{/hasmedia}}
                                {{^hasmedia}}col-md-12{{/hasmedia}}
                                static-content-align">{{{text}}}</div>
                {{/mediaalignleft}}
            </div>
        </div>
    </div>
{{/hascontent}}
