<div class="popular-courses">
    <div class="container-fluid">
        <div class="container nheading">
            {{#hastext}}
                <div class="span5 popular-course-nheading">
                  {{#heading}}<h2>{{.}}</h2>{{/heading}}
                  {{#subheading}}<h4>{{.}}</h4>{{/subheading}}
                  {{#overview}}<p>{{{.}}}</p>{{/overview}}
                </div>
            {{/hastext}}
            {{#hascategories}}
                <div class="{{#hastext}}span7{{/hastext}} popular-course-links">
                    <ul>
                        {{#categories}}
                            <li><a href="{{{url}}}" title="{{name}}">{{name}}</a></li>
                        {{/categories}}
                        <li><a class="viewmore" href="{{{categoriesurl}}}">{{#str}}viewallcategories, theme_school{{/str}}</a></li>
                    </ul>
                </div>
            {{/hascategories}}
        </div>

        <div class="course-items" style="visibility: hidden;">
            <ul class="popular-courses-slider">
                {{#courses}}
                    <li>
                        <div class="course-item">
                            <a href="{{{url}}}" title="{{#str}} courseimage, theme_school, {{name}} {{/str}}">
                                <div class="img-wr" style="background-image: url('{{{imageurl}}}');"></div>
                            </a>
                            <div class="course-item-cont">
                                <h5><a href="{{{url}}}">{{name}}</a></h5>
                                {{#contacts}}
                                    <h6>{{rolename}} : <a href="{{{profileurl}}}" aria-label="{{rolename}} {{name}}">{{name}}</a></h6>
                                {{/contacts}}
                            </div>
                            <div class="btn-plus">
                                <div class="plus-container">
                                    <div class="plus"></div>
                                    <div class="cutoff"></div>
                                </div>
                            </div>
                        </div>
                    </li>
                {{/courses}}
            </ul>
        </div>
        <div class="popular-courses-nav">
            <div><span id="slider-prev" role="button" aria-label="{{#str}} coursesliderprev, theme_school {{/str}}"><i class="fa fa-chevron-circle-left"></i></span></div>
            <div><span id="slider-next" role="button" aria-label="{{#str}} courseslidernext, theme_school {{/str}}"><i class="fa fa-chevron-circle-right"></i></span></div>
        </div>
    </div>
</div>
