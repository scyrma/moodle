<div class="news-updates">
    <div class="d-flex inner ml-auto mr-auto">
        <div class="news-icon">
            <div class="news-icon-container">
                <div class="left"></div>
                <div class="middle">
                    <i class="fa fa-bullhorn"></i>
                </div>
                <div class="right"></div>
            </div>
        </div>
        <div class="row content flex-fill">
            <div class="col-md-{{columnspan}}">
                <h3>{{heading}}</h3>
                <p>
                    <a href="{{{linkurl}}}" title="{{linktext}}">
                        {{linktext}}
                        <i class="fa fa-chevron-circle-right"></i>
                    </a>
                </p>
            </div>
            {{#newsitems}}
                <div class="col-md-{{columnspan}}">
                    <p><a href="{{{linkurl}}}">{{title}}</a></p>
                    <h5>{{modified}}</h5>
                </div>
            {{/newsitems}}
            {{^newsitems}}
                <div class="col-md-5">
                    <a href="{{{linkurl}}}">{{#str}} nonewsitems, theme_school {{/str}}</a>
                </div>
            {{/newsitems}}
        </div>
    </div>
</div>
