<footer class="py-3">
    <div class="container-fluid">
        <div class="row-fluid">
            {{#hascontacts}}
                <div class="contact-info {{#hasleftfootnotes}}col-md-4{{/hasleftfootnotes}}{{^hasleftfootnotes}}col-md-6{{/hasleftfootnotes}}">
                    <h4>{{#str}} contactus, theme_school {{/str}}</h4>
                    <ul id="contact-list" class="list-unstyled">
                        {{#address}}<li><i class="fa fa-map-marker"></i>{{.}}</li>{{/address}}
                        {{#phone}}<li><i class="fa fa-phone"></i>{{.}}</li>{{/phone}}
                        {{#email}}<li><i class="fa fa-envelope-o"></i>{{.}}</li>{{/email}}
                    </ul>
                    <ul id="social-list" class="list-unstyled">
                        {{#twitterurl}}<li><a href="{{{.}}}" title="{{#str}} twitter, theme_school {{/str}}"><i class="fa fa-twitter"></i></a></li>{{/twitterurl}}
                        {{#youtubeurl}}<li><a href="{{{.}}}" title="{{#str}} youtube, theme_school {{/str}}"><i class="fa fa-youtube"></i></a></li>{{/youtubeurl}}
                        {{#facebookurl}}<li><a href="{{{.}}}" title="{{#str}} facebook, theme_school {{/str}}"><i class="fa fa-facebook"></i></a></li>{{/facebookurl}}
                    </ul>
                </div>
            {{/hascontacts}}

            {{{ output.get_gatc }}}
            {{#hasleftfootnotes}}
                <div class="{{#hascontacts}}col-md-4{{/hascontacts}}{{^hascontacts}}col-md-6{{/hascontacts}}">
                    {{{leftfootnote}}}
                    <p class="foot-note-links">
                        {{#footnotelinks}}
                            <a href="{{{url}}}">{{text}}</a>
                            <span>|</span>
                        {{/footnotelinks}}
                    </p>
                </div>
            {{/hasleftfootnotes}}

            <div class="right
                {{#hasleftfootnotes}}
                    {{#hascontacts}}col-md-4{{/hascontacts}}
                    {{^hascontacts}}col-md-6{{/hascontacts}}
                {{/hasleftfootnotes}}
                {{^hasleftfootnotes}}
                    {{#hascontacts}}col-md-6{{/hascontacts}}
                    {{^hascontacts}}col-md-12{{/hascontacts}}
                {{/hasleftfootnotes}}">
                <div id="course-footer">{{{coursefooter}}}</div>
                {{#footnote}}<div class="footnote text-right">{{{.}}}</div>{{/footnote}}
                {{#doclinks}}<p class="helplink">{{{.}}}</p>{{/doclinks}}
                {{{logininfo}}}
                <div class="container">
                    <div id="course-footer">{{{ output.course_footer }}}</div>
                    <div class="tool_usertours-resettourcontainer"></div>
                    <nav class="nav navbar-nav d-md-none" aria-label="{{#str}}custommenu, admin{{/str}}">
                        {{# output.custom_menu_flat }}
                            <ul class="list-unstyled pt-3">
                                {{> theme_boost/custom_menu_footer }}
                            </ul>
                        {{/ output.custom_menu_flat }}
                    </nav>
                </div>
            </div>
        </div>
        {{{ standardfooterhtml }}}
    </div><!-- END of .container-fluid -->
</footer><!-- END of footer -->
