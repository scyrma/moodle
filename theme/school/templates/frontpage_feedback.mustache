<div class="row-fluid">
    <div class="students-area">
        <div class="container">
            {{#hastext}}
                <div class="students-area-feedback
                    {{#hasslides}}span5{{/hasslides}}
                    {{^hasslides}}no-slides{{/hasslides}}">
                        {{#heading}}<h3>{{.}}</h3>{{/heading}}
                        {{#subheading}}<h2>{{.}}</h2>{{/subheading}}
                        {{#iframe}}{{{.}}}{{/iframe}}
                        {{#brieftext}}{{{.}}}{{/brieftext}}
                </div>
            {{/hastext}}
            {{#hasslides}}
            <div {{#hastext}}class="span7 masonry-2-col"{{/hastext}}>
                {{#slides}}
                    <div class="grid-testimo {{#imageurl}}with-image{{/imageurl}}">
                        <div class="blog_box">
                            {{#imageurl}}<div class="blog_box_bloger"><img src="{{{.}}}" alt="{{#str}} userimage, theme_school {{/str}}"></div>{{/imageurl}}
                            <div class="testimonial-name">{{{name}}}</div>
                            <p class="testimonial-text"><i class="fa fa-quote-left"></i>{{text}}<i class="fa fa-quote-right"></i></p>
                        </div>
                    </div>
                {{/slides}}
            </div>
            {{/hasslides}}
        </div>
    </div>
</div>
