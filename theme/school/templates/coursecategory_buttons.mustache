<div class="center">
    <div class="btn-show-more-wr">
        {{#urls.addcourse}}
            <a class="btn-show-more" href="{{{.}}}">
                <span>{{#str}} addnewcourse {{/str}}</span>
            </a>
        {{/urls.addcourse}}
        {{#urls.requestcourseurl}}
            <a class="btn-show-more" href="{{{.}}}">
                <span>{{#str}} requestcourse {{/str}}</span>
            </a>
        {{/urls.requestcourseurl}}
        {{#urls.pendingcoursesurl}}
            <a class="btn-show-more" href="{{{.}}}">
                <span>{{#str}} coursespending {{/str}}</span>
            </a>
        {{/urls.pendingcoursesurl}}
    </div>
</div>
