{{!
    @template theme_workplace/headerbtn

    This template renders the header buttn.

    Example context (json):
    {
        "pageheadingbutton": "<button>Customize this page</button>"
    }
}}
<header id="page-header">
    <div class="w-100 d-flex px-3 pt-3">
    	<div class="ml-auto">
		{{{pageheadingbutton}}}
		</div>
	</div>
</header>