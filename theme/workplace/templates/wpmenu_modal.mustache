{{!
    @template theme_workplace/wpmenu_modal

    This template renders the main content area for the myoverview block.

    Example context (json):
    {
        "uniqid": 123456,
        "haslinks": true,
        "courses": { "url": "#", "name": "Courses"},
        "organisation": { "url": "#", "name": "Organisation structure"}
    }
}}

{{#haslinks}}
<div id="workplace-menu" data-region="workplace-menu-content" class="modal fade workplace-menu">
    <div class="modal-dialog columns-{{columns}}" role="document">
        <div class="modal-content">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            <div class="content card-deck-wrapper">
                <div class="card-deck m-0">
                    {{#courses}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/courses, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/courses}}
                    {{#programs}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/programs, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/programs}}
                    {{#certifications}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/certifications, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/certifications}}
                    {{#certificates}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/certificates, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/certificates}}
                    {{#organisation}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/organization_structure, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/organisation}}
                    {{#users}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/users, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/users}}
                    {{#tenants}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">

                        {{#pix}} menu/tenants, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/tenants}}
                    {{#reportbuilder}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/report_builder, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/reportbuilder}}
                    {{#dynamicrules}}

                    <a class="card border-0 wpmenu-item my-3 d-flex flex-column text-center align-items-center justify-content-center m-0 p-0" href="{{url}}">
                        {{#pix}} menu/dynamic_rules, theme_workplace, {{name}} {{/pix}}
                        <span class="mt-2 mb-2">{{{name}}}</span>
                    </a>
                    {{/dynamicrules}}
                </div>
            </div>
        </div>
    </div>
</div>
{{/haslinks}}
