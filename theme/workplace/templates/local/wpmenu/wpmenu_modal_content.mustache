{{!
    @template theme_workplace/local/wpmenu/wpmenu_modal_content

    This template renders the workplace menu modal content.

    Note: This template is separated from the wpmenu_modal_link template because modal backdrop
    is not correctly displayed if it is placed in a non static div or ancestor. Because of that
    it is moved outside the <nav>

    Example context (json):
    {
        "hasitems": true,
        "items": [
            { "url": "#", "name": "Courses", "imageurl": "http://placekitten.com/100/100"},
            { "url": "#", "name": "Organisation structure", "imageurl": "http://placekitten.com/100/100"}
        ],
        "hasglobalitems": true,
        "globalitems": [
            { "url": "#", "name": "Migration", "imageurl": "http://placekitten.com/100/100"}
        ]
    }
}}

{{#hasitems}}
<div id="workplace-menu" data-region="workplace-menu-content" class="modal fade workplace-menu" tabindex='-1'>
    <div class="modal-dialog wpmenu-modal-dialog" role="document">
        <div class="modal-content p-0">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="workplace-menu-grid p-2 overflow-auto">
                {{#items}}
                    {{>theme_workplace/local/wpmenu/wpmenu_item}}
                {{/items}}
            </div>
            {{#hasglobalitems}}
                <div class="border-top">
                    <div class="mx-4 mt-3 font-weight-bold small">
                        {{#str}} global, theme_workplace {{/str}}
                    </div>
                    <div class="workplace-menu-grid p-2">
                        {{#globalitems}}
                            {{>theme_workplace/local/wpmenu/wpmenu_item}}
                        {{/globalitems}}
                    </div>
                </div>
            {{/hasglobalitems}}
        </div>
    </div>
</div>
{{/hasitems}}
