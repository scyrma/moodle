<div class="popular-courses">
    <div class="container-fluid">
        <div class="container nheading">
            <div class="span5 popular-course-nheading">
              {{#heading}}<h4>{{.}}</h4>{{/heading}}
              {{#subheading}}<h2>{{.}}</h2>{{/subheading}}
              {{#overview}}<p>{{.}}</p>{{/overview}}
            </div>
            <div class="span7 popular-course-links">
                <ul>
                    {{#categories}}
                        <li>
                            {{#url}}<a href="{{{.}}}" alt="">{{/url}}
                            {{name}}
                            {{#url}}</a>{{/url}}
                        </li>
                    {{/categories}}
                    <li><a class="viewmore" href="{{{categoriesurl}}}" alt="">{{#str}}viewallcourses, theme_tikli{{/str}}</a></li>
                </ul>
            </div>
        </div>

        <div class="course-items">
            <ul class="popular-courses-slider">
                {{#courses}}
                    <li>
                        <div class="course-item">
                            <div class="img-wr">
                                <a href="{{{url}}}"><img src="{{{imageurl}}}" alt="{{#str}} courseimage, theme_tikli, {{name}} {{/str}}"></a>
                            </div>
                            <div class="course-item-cont">
                                <h5><a href="{{{url}}}">{{name}}</a></h5>
                                {{#contacts}}
                                    <h6>{{rolename}} : <a href="{{{profileurl}}}">{{name}}</a></h6>
                                {{/contacts}}
                            </div>
                            <a href="{{{url}}}" class="btn-plus">
                                <div class="plus-container">
                                    <div class="plus">&#43;</div>
                                    <div class="cutoff"></div>
                                </div>
                            </a>
                        </div>
                    </li>
                {{/courses}}
            </ul>
        </div>
        <div class="popular-courses-nav">
            <div><span id="slider-prev"><img src="{{{imageurls.sliderprev}}}" alt="{{#str}} sliderprev, theme_tikli {{/str}}"></span></div>
            <div><span id="slider-next"><img src="{{{imageurls.slidernext}}}" alt="{{#str}} slidernext, theme_tikli {{/str}}"></span></div>
        </div>
    </div>
</div>
