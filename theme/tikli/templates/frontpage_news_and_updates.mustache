<div class="news-updates">
    <div class="container">
        <div class="row">
            <div class="span3">
                <h3>{{{heading}}}</h3>
                <p>
                    <a href="{{{linkurl}}}" class="btn-see-all">
                        {{linktext}}
                        <i><img src="{{{linkiconurl}}}" alt=""></i>
                    </a>
                </p>
            </div>
            {{#newsitems}}
                <div class="span3 news-updates-extraclass">
                    <p><a href="{{{linkurl}}}">{{title}}</a></p>
                    <h5>{{description}}</h5>
                </div>
            {{/newsitems}}
        </div>
    </div>
</div>
