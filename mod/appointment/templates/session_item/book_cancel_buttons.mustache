{{!
    @template mod_appointment/session_item/book_cancel_buttons

    Template for showing session list item.

    Example context (json):
    {
        "bookaction": "signup",
        "bookactiontitle": "Book",
        "sessionid": "1"
    }
}}
<div class="d-flex position-relative z-index-1">
    {{#bookaction}}
        <button class="btn btn-primary"
                data-action="{{bookaction}}" data-id="{{sessionid}}"
                title="{{bookactiontitle}}">{{bookactiontitle}}
        </button>
    {{/bookaction}}
    {{#cancelaction}}
        <button class="btn btn-danger"
                data-action="{{cancelaction}}" data-id="{{sessionid}}"
                title="{{#str}} cancelbooking, mod_appointment {{/str}}">{{#str}} cancel, mod_appointment {{/str}}
        </button>
    {{/cancelaction}}
</div>
