{{!
    @template mod_appointment/session_status

    Template for showing session status.

    Example context (json):
    {
        "status": "Booked",
        "isbooked": true,
        "isstarted": true,
        "isfull": false
    }
}}
<div class="row">
    <div class="col small text-gray080" id="session-item-status-{{uniqid}}">{{#str}} status, mod_appointment {{/str}}</div>
</div>
<div class="row">
    <div class="col" aria-labelledby="session-item-status-{{uniqid}}">{{status}}</div>
</div>
