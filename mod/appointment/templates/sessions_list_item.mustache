{{!
    @template mod_appointment/sessions_list_item

    Template for showing session list item.

    Example context (json):
    {}
}}
<div class="container-fluid card session-card rounded" data-sessionid="{{sessionid}}">
    <div class="row">
        <div class="col-lg-5 p-4 {{#sessiontimeknown}}bg-gray020{{/sessiontimeknown}}">
            {{> mod_appointment/session_datetime}}
        </div>
        <div class="col-lg-2 p-4">
            {{> mod_appointment/session_capacity}}
        </div>
        <div class="col-lg-2 p-4">
            {{> mod_appointment/session_status}}
        </div>
        <div class="col-lg-3 p-4">
            <div class="mb-0 d-flex">
                <span class="ml-auto">
                    <button class="btn btn-outline-secondary d-inline-block"
                        data-action="details" data-id="{{sessionid}}"
                        title="{{detailstitle}}">{{detailstitle}}</button>
                    {{#cancelenabled}}
                    <button class="btn btn-danger d-inline-block"
                        data-action="cancelsignup" data-id="{{sessionid}}"
                        title="{{canceltitle}}">{{canceltitle}}</button>
                    {{/cancelenabled}}
                    {{#signupenabled}}
                    <button class="btn btn-primary d-inline-block"
                        data-action="signup" data-id="{{sessionid}}"
                        title="{{signuptitle}}">{{signuptitle}}</button>
                    {{/signupenabled}}
                    {{#actions}}
                    <div class="d-inline-block pl-3">
                        {{> core/action_menu}}
                    </div>
                    {{/actions}}
                </span>
            </div>
        </div>
    </div>
</div>
