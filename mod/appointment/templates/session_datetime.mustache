{{!
    @template mod_appointment/session_datetime

    Template for showing session times.

    Example context (json):
    {
        "sessiontimes": [
            {
                "date": "Tue, June 11",
                "time": "11:00 - 14:00"
            }
        ]
    }
}}
<div class="row">
    <div class="col small text-gray080" id="session-item-date-{{uniqid}}">{{#str}} date {{/str}}</div>
    <div class="col small text-gray080" id="session-item-time-{{uniqid}}">{{#str}} time {{/str}}</div>
</div>
{{#sessiontimes}}
<div class="row">
    <div class="col" aria-labelledby="session-item-date-{{uniqid}}">{{date}}</div>
    <div class="col" aria-labelledby="session-item-time-{{uniqid}}">{{time}}</div>
</div>
{{/sessiontimes}}
