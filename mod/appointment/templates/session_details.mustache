{{!
    @template mod_appointment/session_details

    Template for showing session details.

    Example context (json):
    {
        "details": "Some random details string"
    }
}}
<div class="row">
    <div class="col small text-gray080" id="session-item-details-{{uniqid}}">{{#str}} sessiondescription, mod_appointment {{/str}}</div>
</div>
<div class="row">
    <div class="col" aria-labelledby="session-item-details-{{uniqid}}">{{{details}}}</div>
</div>
