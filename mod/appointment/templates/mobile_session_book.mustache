{{!
    @template mod_appointment/mobile_session_book

    Template for showing session booking form in mobile app.

    Example context (json):
    {
    }
}}
{{=<% %>=}}
<form id="signup">
<ion-list>
    <ion-item>
        <ion-grid>
            <ion-row>
                <ion-col>
                    <%#sessiontimes%>
                    <p style="margin-top: 10px;"><strong><% date %> <br> <% time %></strong></p>
                    <%/sessiontimes%>
                    <p style="margin-top: 10px;">{{ 'plugin.mod_appointment.capacity' | translate }}: <% capacity %></p>
                    <p style="margin-top: 10px;">{{ 'plugin.mod_appointment.status' | translate }}: <% status %></p>
                    <%#fields%>
                    <p style="margin-top: 10px;"><% name %>: <core-format-text text="<% value %>" component="mod_appointment" componentId="<% cmid %>"></core-format-text></p>
                    <%/fields%>
                    <p style="margin-top: 10px;">{{ 'plugin.mod_appointment.sessiondescription' | translate }}:</p>
                    <p><core-format-text text="<% details %>" component="mod_appointment" componentId="<% cmid %>"></core-format-text></p>
                </ion-col>
            </ion-row>
            <ion-row>
                <ion-col>
                    <%#bookaction%>
                    <ion-button block type="submit" core-site-plugins-call-ws name="mod_appointment_user_signup" title="<% bookactiontitle %>" goBackOnSuccess="true"
                    [params]="{sessionid: <% sessionid %>}" form="signup"
                    [preSets]="{getFromCache: 0, saveToCache: 0, typeExpected: 'boolean'}" (onSuccess)="afterCall();">
                        <% bookactiontitle %>
                    </ion-button>
                    <%/bookaction%>
                </ion-col>
            </ion-row>
        </ion-grid>
    </ion-item>
</ion-list>
</form>
