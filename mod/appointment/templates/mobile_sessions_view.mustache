{{!
    @template mod_appointment/mobile_sessions_view

    Template for showing list of sessions in mobile app.

    Example context (json):
    {
    }
}}
{{=<% %>=}}
<div>
    <ion-list>
        <%#appointment.intro%>
        <ion-item>
            <ion-grid>
                <ion-row>
                    <ion-col>
                        <p><core-format-text text="<% appointment.intro %>" component="mod_appointment" componentId="<% cmid %>"></core-format-text></p>
                    </ion-col>
                </ion-row>
            </ion-grid>
        </ion-item>
        <%/appointment.intro%>
        <%#sessions%>
        <ion-item>
            <ion-grid>
                <ion-row>
                    <ion-col>
                        <%#sessiontimes%>
                        <p style="margin-top: 10px;"><strong><% date %> <br> <% time %></strong></p>
                        <%/sessiontimes%>
                        <p style="margin-top: 10px;">{{ 'plugin.mod_appointment.capacity' | translate }}: <% capacity %></p>
                        <p style="margin-top: 10px;">{{ 'plugin.mod_appointment.status' | translate }}: <% status %></p>
                    </ion-col>
                </ion-row>
                <ion-row>
                    <ion-col size="auto">
                        <ion-button block color="light" core-site-plugins-new-content title="<% detailstitle %>"
                        component="mod_appointment" method="mobile_session_details" [args]="{cmid: <% cmid %>, sessionid: <% sessionid %>}">
                            <% detailstitle %>
                        </ion-button>
                    </ion-col>
                    <ion-col>
                    <%#bookaction%>
                        <ion-button block core-site-plugins-new-content title="<% bookactiontitle %>"
                        component="mod_appointment" method="mobile_session_book" [args]="{cmid: <% cmid %>, sessionid: <% sessionid %>}">
                            <% bookactiontitle %>
                        </ion-button>
                    <%/bookaction%>
                    <%#cancelaction%>
                        <ion-button block core-site-plugins-new-content color="danger" title="{{ 'plugin.mod_appointment.cancelbooking' | translate }}"
                        component="mod_appointment" method="mobile_session_cancel" [args]="{cmid: <% cmid %>, sessionid: <% sessionid %>}">
                            {{ 'plugin.mod_appointment.cancel' | translate }}
                        </ion-button>
                    <%/cancelaction%>
                    </ion-col>
                </ion-row>
            </ion-grid>
        </ion-item>
        <%/sessions%>
    </ion-list>

</div>
