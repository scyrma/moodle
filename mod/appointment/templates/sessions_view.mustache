{{!
    @template mod_appointment/sessions_view

    Template for showing list of sessions.

    Example context (json):
    {
        "addbuttontitle": "Add session",
        "addbuttonurl": "#",
        "intro": "Appointment intro",
        "sessionslisttable": "<table></table>"
    }
}}
<div class="appointment-intro">
    {{{intro}}}
</div>
{{#actions}}
    <div class="row float-right mr-3">
        {{> core/action_menu}}
    </div>
{{/actions}}
<div class="sessions-list" data-region="appointment-sessions-list">
    {{{sessionslisttable}}}
</div>
{{#js}}
    require(['mod_appointment/sessions_list'], function(sessionsList) {
        sessionsList.init();
    });
{{/js}}
